# ==============================================================================
# Contact Form Filler - Backend Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# Application
APP_NAME="Contact Form Filler"
APP_ENV="development"
LOG_LEVEL="INFO"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# MySQL Database
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="form_insights"
MYSQL_POOL_SIZE=10

# Automation & Playwright
HEADLESS=true
CONCURRENCY=2
PER_WEBSITE_TIMEOUT_SEC=60
ACTION_TIMEOUT_MS=10000
POST_SUBMIT_WAIT_MS=8000
SUBMIT_WAIT_MS=10000
POLITE_DELAY_MS=500
MAX_RETRIES=2
DRY_RUN=false
ALLOW_RERUNS=true

# Security
# Set to true ONLY for controlled local testing (e.g. test_contact_form.html on localhost)
ALLOW_LOCALHOST_TESTING=true
